{
    "name": "@w3d/monorepo",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "W3D Studio - 开源 WebGL 三维编辑器 Monorepo",
    "author": "W3D Team",
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "node": ">=16.0.0",
        "pnpm": ">=8.0.0"
    },
    "scripts": {
        "dev": "pnpm --filter @w3d/editor-w3d dev",
        "dev:ai": "pnpm --filter @w3d/editor-ai-gateway dev",
        "dev:core": "pnpm --filter @w3d/core dev",
        "dev:components": "pnpm --filter @w3d/components dev",
        "dev:utils": "pnpm --filter @w3d/utils dev",
        "dev:site": "pnpm --filter @w3d/site dev",
        "dev:editor": "pnpm --filter @w3d/editor-w3d dev",
        "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm --filter @w3d/editor-w3d build",
        "build:core": "pnpm --filter @w3d/core build",
        "build:components": "pnpm --filter @w3d/components build",
        "build:utils": "pnpm --filter @w3d/utils build",
        "build:site": "pnpm --filter @w3d/site build",
        "build:editor": "pnpm --filter @w3d/editor-w3d build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint \"packages/core/**/*.js\" \"packages/components/**/*.js\" \"packages/editor-w3d/**/*.js\" \"packages/utils/**/*.js\"",
        "lint:fix": "eslint \"packages/core/**/*.js\" \"packages/components/**/*.js\" \"packages/editor-w3d/**/*.js\" \"packages/utils/**/*.js\" --fix",
        "format": "prettier --write \"packages/**/*.js\"",
        "format:check": "prettier --check \"packages/**/*.js\"",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish",
        "clean": "pnpm -r exec rimraf dist node_modules",
        "clean:dist": "pnpm -r exec rimraf dist",
        "clean:node_modules": "pnpm -r exec rimraf node_modules",
        "install:deps": "pnpm install && pnpm install:missing",
        "install:missing": "pnpm add -D jsdom @vitest/coverage-v8 rimraf"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.1",
        "@vitest/coverage-v8": "^1.3.1",
        "@vitest/ui": "^1.3.1",
        "@vue/test-utils": "^2.4.6",
        "cross-env": "^10.1.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "fast-check": "^4.5.3",
        "jsdom": "^24.0.0",
        "lerna": "^8.0.2",
        "prettier": "^3.2.5",
        "rimraf": "^5.0.5",
        "terser": "^5.44.0",
        "vite": "^5.1.4",
        "vitest": "^1.3.1"
    },
    "keywords": [
        "webgl",
        "3d",
        "threejs",
        "rendering",
        "engine",
        "monorepo",
        "lerna",
        "vite"
    ],
    "pnpm": {
        "overrides": {
            "three": "0.184.0"
        }
    }
}
